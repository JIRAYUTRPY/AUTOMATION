# Copy to .env and adjust. Placeholders only - never commit real secrets.
# install.sh generates this file for you, including the secrets below.

# --- Release / images ---
AUTOMATION_VERSION=latest
AUTOMATION_IMAGE_PREFIX=ghcr.io/jirayutrpy/automation

# --- Application ---
APP_PORT=3000
PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info

# Required to use the in-app Update button. Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# --- Optional updater (mounts the Docker socket; read SECURITY.md first) ---
# Enable with: COMPOSE_PROFILES=updater and UPDATER_ENABLED=true
COMPOSE_PROFILES=
UPDATER_ENABLED=false
UPDATER_TOKEN=
UPDATE_REPO=JIRAYUTRPY/automation
# Absolute path of the directory holding docker-compose.yml and this .env
INSTALL_DIR=/opt/automation

# --- Persistence (SQLite file on the shared data volume) ---
DATABASE_URL=file:/data/automation.db
ARTIFACT_DIR=/data/artifacts
ARTIFACT_RETENTION_DAYS=30

# --- Worker ---
BROWSER_CONCURRENCY=2

# --- Crawl limits (server-side upper bounds are enforced in code) ---
CRAWL_MAX_PAGES=100
CRAWL_MAX_CONCURRENCY=2
NAVIGATION_TIMEOUT_MS=15000
JOB_TIMEOUT_MS=600000

# --- Scope policy ---
# Comma-separated origins the scanner/runner may visit. Leave empty to allow
# only the origin configured per project.
ALLOWED_ORIGINS=
